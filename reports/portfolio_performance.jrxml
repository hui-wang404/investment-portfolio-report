<jasperReport name="portfolio_performance" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8c670a52-7a3c-4657-9dff-226acd267a28">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<query language="sql"><![CDATA[SELECT
    i.investment_id,
    f.fund_name,
    c.company_name,
    s.sector_name,
    c.country,
    i.investment_date,
    i.invested_capital,
    i.current_nav,
    i.realized_proceeds,
    i.status
FROM investments i
JOIN funds f ON i.fund_id = f.fund_id
JOIN companies c ON i.company_id = c.company_id
JOIN sectors s ON c.sector_id = s.sector_id
ORDER BY i.invested_capital DESC]]></query>
