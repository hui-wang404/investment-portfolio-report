		<property name="com.jaspersoft.studio.field.label" value="current_nav"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="investments"/>
	</field>
	<field name="realized_proceeds" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="realized_proceeds"/>
		<property name="com.jaspersoft.studio.field.label" value="realized_proceeds"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="investments"/>
