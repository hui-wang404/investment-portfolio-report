		<property name="com.jaspersoft.studio.field.label" value="status"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="investments"/>
	</field>
	<variable name="UnrealizedGainLoss" class="java.math.BigDecimal">
		<expression><![CDATA[$F{current_nav}.subtract($F{invested_capital})]]></expression>
	</variable>
	<variable name="TotalInvestedCapital" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{invested_capital}]]></expression>
	</variable>
	<variable name="TotalCurrentNAV" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{current_nav}]]></expression>
	</variable>
	<variable name="TotalUnrealizedGainLoss" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$V{UnrealizedGainLoss}]]></expression>
	</variable>
	<variable name="InvestmentCount" calculation="Count" class="java.lang.Integer">
		<expression><![CDATA[$F{investment_id}]]></expression>
	</variable>
